{
  "name": "selfmusic",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted personal music library with a mobile-first web player",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^7.0.0"
  }
}
