# SelfMusic runtime settings. Docker Compose overrides MUSIC_DIR to /app/music.
SELF_MUSIC_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
MUSIC_DIR=./music
PORT=8787
NODE_ENV=production

# Optional: enables the Explore YouTube search page (YouTube Data API v3).
YOUTUBE_API_KEY=

# Maximum duration in seconds for YouTube audio downloads (default: 3600).
YOUTUBE_MAX_DURATION_SECONDS=3600

# Tailscale auth key. Create a reusable key and allow tag:selfmusic in your tailnet policy:
# https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=

# Host path containing your music files. This folder is mounted at /app/music in the container.
MUSIC_HOST_DIR=./music
