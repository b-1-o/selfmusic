# SelfMusic runtime settings.
SELF_MUSIC_PASSWORD=replace-with-a-unique-password-at-least-8-characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
MUSIC_DIR=./music
PORT=8787
NODE_ENV=production

# Persistent SQLite database and extracted cover art. Relative paths are resolved from the project root.
DATABASE_PATH=./data/selfmusic.sqlite
COVER_CACHE_DIR=./data/artwork

# Optional: enables YouTube search (official YouTube Data API v3 is search-only).
YOUTUBE_API_KEY=
YOUTUBE_MAX_DURATION_SECONDS=3600
YOUTUBE_CACHE_TTL_SECONDS=300

# Transcoding (requires ffmpeg).
TRANSCODE_ENABLED=false
TRANSCODE_CACHE_DIR=./data/transcodes
DEFAULT_BITRATE=192k

# SHA-256 duplicate detection: skip, keep, or ask.
DUPLICATE_STRATEGY=keep

# Optional mutagen/Python path override, useful on Windows.
PYTHON_PATH=

# Multi-user bootstrap and API security. Keep secrets local; never commit .env.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Last.fm integration is optional. Per-user session keys are stored encrypted/secured by the server deployment.
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_CALLBACK_URL=

# Lightweight per-IP rate limiting for costly public endpoints.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=60
HEAVY_API_RATE_LIMIT_MAX=8

# Tailscale auth key (Docker sidecar only). Store this in .env, never in Git.
TS_AUTHKEY=

# Host folder mounted at /app/music when using Docker.
MUSIC_HOST_DIR=./music
