# Copy this file to .env, then replace the placeholders locally.
# Never put real passwords, session secrets, API keys, or personal paths in this template.
SELF_MUSIC_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Folder containing your audio files; paths are relative to the project folder by default.
MUSIC_DIR=./music

# Local HTTP port. Keep behind a private network or HTTPS tunnel for remote access.
PORT=8787
NODE_ENV=development

# Optional: YouTube Data API v3 key for video search. Keep the key in .env only.
YOUTUBE_API_KEY=
