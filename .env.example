# Required: choose a strong, unique password before exposing the server.
SELF_MUSIC_PASSWORD=replace-with-a-long-unique-password

# Replace with a long random value. Keep this secret.
SESSION_SECRET=replace-with-a-random-secret

# Folder containing your own music files. Relative paths are based on the project folder.
MUSIC_DIR=./music

# The local HTTP port. Keep this behind an HTTPS tunnel or reverse proxy for remote use.
PORT=8787
NODE_ENV=development

# Optional: enable YouTube search with YouTube Data API v3. Keep this server-side.
YOUTUBE_API_KEY=
